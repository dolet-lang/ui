import ui
import fonts

fun main() -> i32:
    surface: UISurface = ui_surface_create(64, 64)
    if surface.is_valid() == 0:
        print("ui smoke: surface create failed")
        return 1

    commands: UIDrawList = ui_draw_list_create(2)
    if commands.is_valid() == 0:
        surface.destroy()
        print("ui smoke: command list create failed")
        return 2

    commands.push_clear(64, 64, ui_rgb(1, 2, 3))
    commands.push_clip(4, 4, 56, 56)
    commands.push_clip(8, 8, 48, 48)
    commands.push_fill_rect(0, 0, 64, 64, ui_rgba(220, 80, 40, 180))
    commands.pop_clip()
    commands.push_text(8, 8, "safe command text", ui_rgb(255, 255, 255))
    commands.pop_clip()

    canvas: DrawCanvas = surface.canvas()
    commands.render(canvas)

    blended: i32 = Memory.read_i32(surface.pixels + (30 as i64) * (surface.pitch as i64) + (30 as i64) * 4)
    if blended != ui_rgb(155, 57, 29):
        commands.destroy()
        surface.destroy()
        print("ui smoke: alpha blend failed")
        return 3

    if commands.count < 6 or commands.capacity <= 2:
        commands.destroy()
        surface.destroy()
        print("ui smoke: command growth failed")
        return 4
    if commands.dropped != 0:
        commands.destroy()
        surface.destroy()
        print("ui smoke: command dropped")
        return 5

    if surface.text_height() != 16 or surface.text_width("abc") != surface.font_advance * 3:
        commands.destroy()
        surface.destroy()
        print("ui smoke: font metrics failed")
        return 6

    background: i32 = ui_rgb(0, 0, 0)
    foreground: i32 = ui_rgb(255, 255, 255)
    canvas.clear(64, 64, background)
    canvas.fill_rounded_rect(8, 8, 32, 24, 7, foreground)
    i: i32 = 0
    partial: i32 = 0
    pixel: i32 = 0
    while i < 64 * 64:
        pixel = Memory.read_i32(surface.pixels + (i as i64) * 4)
        if pixel != background and pixel != foreground:
            partial = 1
        i = i + 1
    if partial == 0:
        commands.destroy()
        surface.destroy()
        print("ui smoke: rounded coverage failed")
        return 7

    canvas.clear(64, 64, background)
    canvas.text(4, 4, "Aa", foreground)
    i = 0
    partial = 0
    while i < 64 * 64:
        pixel = Memory.read_i32(surface.pixels + (i as i64) * 4)
        if pixel != background and pixel != foreground:
            partial = 1
        i = i + 1
    if partial == 0:
        commands.destroy()
        surface.destroy()
        print("ui smoke: text coverage failed")
        return 8

    custom_face: FontFace = font_face_basic_smooth(18)
    if custom_face.is_valid() == 0:
        commands.destroy()
        surface.destroy()
        print("ui smoke: custom face create failed")
        return 9
    if surface.use_font_face(custom_face) == 0 or surface.text_height() != 20:
        commands.destroy()
        surface.destroy()
        custom_face.destroy()
        print("ui smoke: custom face switch failed")
        return 10

    # A canvas with a second glyph block must resolve BOTH blocks, for the
    # glyph and for its advance. Sending the second block to the fallback
    # advance is invisible in Latin and pulls every Arabic word apart.
    advances: i64 = Memory.malloc_zeroed(8 * 4)
    if advances == 0:
        commands.destroy()
        surface.destroy()
        custom_face.destroy()
        print("ui smoke: allocation failed")
        return 11
    i: i32 = 0
    while i < 8:
        Memory.write_i32(advances + (i as i64) * 4, 3 + i)
        i = i + 1
    # Block one: codepoints 100..104. Block two: 200..202, at slots 5..7.
    probe: DrawCanvas = draw_canvas_from_font_face_ranges(surface.pixels, surface.width, surface.height, surface.pitch, surface.font, 8, 8, 9, 10, 100, 5, 64, FONT_FORMAT_A8, advances, 200, 3)
    if probe.font_glyph_index(100) != 0 or probe.font_glyph_index(104) != 4:
        Memory.free(advances)
        commands.destroy()
        surface.destroy()
        custom_face.destroy()
        print("ui smoke: the first glyph block is misaddressed")
        return 12
    if probe.font_glyph_index(200) != 5 or probe.font_glyph_index(202) != 7:
        Memory.free(advances)
        commands.destroy()
        surface.destroy()
        custom_face.destroy()
        print("ui smoke: the second glyph block is misaddressed")
        return 13
    if probe.font_glyph_index(150) != 0 - 1:
        Memory.free(advances)
        commands.destroy()
        surface.destroy()
        custom_face.destroy()
        print("ui smoke: a codepoint in neither block resolved to a glyph")
        return 14
    if probe.glyph_advance(0) != 3 or probe.glyph_advance(4) != 7:
        Memory.free(advances)
        commands.destroy()
        surface.destroy()
        custom_face.destroy()
        print("ui smoke: the first block took the fallback advance")
        return 15
    if probe.glyph_advance(5) != 8 or probe.glyph_advance(7) != 10:
        Memory.free(advances)
        commands.destroy()
        surface.destroy()
        custom_face.destroy()
        print("ui smoke: the second block took the fallback advance")
        return 16
    if probe.glyph_advance(8) != 9:
        Memory.free(advances)
        commands.destroy()
        surface.destroy()
        custom_face.destroy()
        print("ui smoke: an out-of-range glyph did not take the fallback")
        return 17
    Memory.free(advances)

    commands.destroy()
    surface.destroy()
    custom_face.destroy()
    print("ui smoke: ok")
    return 0
