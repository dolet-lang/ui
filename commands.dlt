# ============================
#  Backend-Neutral Draw Commands
# ============================

struct UIDrawList:
    kinds: i64 = 0
    xs: i64 = 0
    ys: i64 = 0
    widths: i64 = 0
    heights: i64 = 0
    x2s: i64 = 0
    y2s: i64 = 0
    colors: i64 = 0
    backgrounds: i64 = 0
    thicknesses: i64 = 0
    texts: i64 = 0
    count: i32 = 0
    capacity: i32 = 0
    text_data: i64 = 0
    text_used: i64 = 0
    text_capacity: i64 = 0
    clip_xs: i64 = 0
    clip_ys: i64 = 0
    clip_ws: i64 = 0
    clip_hs: i64 = 0
    clip_top: i32 = 0
    clip_capacity: i32 = 0
    dropped: i32 = 0

attach UIDrawList:
    static fun create(capacity: i32) -> UIDrawList:
        list: UIDrawList = UIDrawList()
        if capacity <= 0:
            return list

        list.kinds = Memory.malloc_zeroed(capacity * 4)
        list.xs = Memory.malloc_zeroed(capacity * 4)
        list.ys = Memory.malloc_zeroed(capacity * 4)
        list.widths = Memory.malloc_zeroed(capacity * 4)
        list.heights = Memory.malloc_zeroed(capacity * 4)
        list.x2s = Memory.malloc_zeroed(capacity * 4)
        list.y2s = Memory.malloc_zeroed(capacity * 4)
        list.colors = Memory.malloc_zeroed(capacity * 4)
        list.backgrounds = Memory.malloc_zeroed(capacity * 4)
        list.thicknesses = Memory.malloc_zeroed(capacity * 4)
        list.texts = Memory.malloc_zeroed(capacity * 8)
        list.text_capacity = (capacity as i64) * 24 + 1
        list.text_data = Memory.malloc_zeroed(list.text_capacity)
        list.text_used = 1
        list.clip_capacity = 16
        list.clip_xs = Memory.malloc_zeroed(list.clip_capacity * 4)
        list.clip_ys = Memory.malloc_zeroed(list.clip_capacity * 4)
        list.clip_ws = Memory.malloc_zeroed(list.clip_capacity * 4)
        list.clip_hs = Memory.malloc_zeroed(list.clip_capacity * 4)
        list.count = capacity - capacity
        list.capacity = capacity

        if list.has_storage() == 0:
            list.destroy()
            return UIDrawList()

        return list

    fun destroy(self):
        if self.kinds != 0:
            Memory.free(self.kinds)
        if self.xs != 0:
            Memory.free(self.xs)
        if self.ys != 0:
            Memory.free(self.ys)
        if self.widths != 0:
            Memory.free(self.widths)
        if self.heights != 0:
            Memory.free(self.heights)
        if self.x2s != 0:
            Memory.free(self.x2s)
        if self.y2s != 0:
            Memory.free(self.y2s)
        if self.colors != 0:
            Memory.free(self.colors)
        if self.backgrounds != 0:
            Memory.free(self.backgrounds)
        if self.thicknesses != 0:
            Memory.free(self.thicknesses)
        if self.texts != 0:
            Memory.free(self.texts)
        if self.text_data != 0:
            Memory.free(self.text_data)
        if self.clip_xs != 0:
            Memory.free(self.clip_xs)
        if self.clip_ys != 0:
            Memory.free(self.clip_ys)
        if self.clip_ws != 0:
            Memory.free(self.clip_ws)
        if self.clip_hs != 0:
            Memory.free(self.clip_hs)

        self.kinds = 0
        self.xs = 0
        self.ys = 0
        self.widths = 0
        self.heights = 0
        self.x2s = 0
        self.y2s = 0
        self.colors = 0
        self.backgrounds = 0
        self.thicknesses = 0
        self.texts = 0
        self.text_data = 0
        self.text_used = 0
        self.text_capacity = 0
        self.clip_xs = 0
        self.clip_ys = 0
        self.clip_ws = 0
        self.clip_hs = 0
        self.clip_top = 0
        self.clip_capacity = 0
        self.dropped = 0
        self.count = self.count - self.count
        self.capacity = self.capacity - self.capacity

    fun clear(self):
        self.count = self.count - self.count
        self.text_used = 1
        self.clip_top = 0
        self.dropped = 0
        if self.text_data != 0:
            Memory.write_i8(self.text_data, 0)

    fun is_valid(self) -> i32:
        return self.has_storage()

    fun push_clear(self, width: i32, height: i32, color: UIColor):
        self.write_command(UI_CMD_CLEAR, 0, 0, width, height, 0, 0, color, 0, 0, "")

    fun push_fill_rect(self, x: i32, y: i32, width: i32, height: i32, color: UIColor):
        self.write_command(UI_CMD_FILL_RECT, x, y, width, height, 0, 0, color, 0, 0, "")

    fun push_outline_rect(self, x: i32, y: i32, width: i32, height: i32, color: UIColor, thickness: i32):
        self.write_command(UI_CMD_OUTLINE_RECT, x, y, width, height, 0, 0, color, 0, thickness, "")

    fun push_line(self, x1: i32, y1: i32, x2: i32, y2: i32, color: UIColor, thickness: i32):
        self.write_command(UI_CMD_LINE, x1, y1, 0, 0, x2, y2, color, 0, thickness, "")

    fun push_text(self, x: i32, y: i32, value: str, color: UIColor):
        self.write_command(UI_CMD_TEXT, x, y, 0, 0, 0, 0, color, 0, 0, value)

    fun push_text_bg(self, x: i32, y: i32, value: str, color: UIColor, background: UIColor):
        self.write_command(UI_CMD_TEXT_BG, x, y, 0, 0, 0, 0, color, background, 0, value)

    fun push_fill_circle(self, cx: i32, cy: i32, radius: i32, color: UIColor):
        self.write_command(UI_CMD_FILL_CIRCLE, cx, cy, radius, 0, 0, 0, color, 0, 0, "")

    fun push_outline_circle(self, cx: i32, cy: i32, radius: i32, color: UIColor, thickness: i32):
        self.write_command(UI_CMD_OUTLINE_CIRCLE, cx, cy, radius, 0, 0, 0, color, 0, thickness, "")

    fun push_fill_rounded_rect(self, x: i32, y: i32, width: i32, height: i32, radius: i32, color: UIColor):
        self.write_command(UI_CMD_FILL_ROUNDED_RECT, x, y, width, height, radius, 0, color, 0, 0, "")

    fun push_outline_rounded_rect(self, x: i32, y: i32, width: i32, height: i32, radius: i32, color: UIColor, thickness: i32):
        self.write_command(UI_CMD_OUTLINE_ROUNDED_RECT, x, y, width, height, radius, 0, color, 0, thickness, "")

    fun push_clip(self, x: i32, y: i32, width: i32, height: i32):
        if self.ensure_clip_capacity(self.clip_top + 1) == 0:
            self.dropped = self.dropped + 1
            return
        nx: i32 = x
        ny: i32 = y
        nw: i32 = width
        nh: i32 = height
        if self.clip_top > 0:
            prev: i64 = ((self.clip_top - 1) as i64) * 4
            px: i32 = Memory.read_i32(self.clip_xs + prev)
            py: i32 = Memory.read_i32(self.clip_ys + prev)
            pw: i32 = Memory.read_i32(self.clip_ws + prev)
            ph: i32 = Memory.read_i32(self.clip_hs + prev)
            if nx < px:
                nx = px
            if ny < py:
                ny = py
            right: i32 = x + width
            bottom: i32 = y + height
            if right > px + pw:
                right = px + pw
            if bottom > py + ph:
                bottom = py + ph
            nw = right - nx
            nh = bottom - ny
        if nw < 0:
            nw = 0
        if nh < 0:
            nh = 0
        off: i64 = (self.clip_top as i64) * 4
        Memory.write_i32(self.clip_xs + off, nx)
        Memory.write_i32(self.clip_ys + off, ny)
        Memory.write_i32(self.clip_ws + off, nw)
        Memory.write_i32(self.clip_hs + off, nh)
        self.clip_top = self.clip_top + 1
        self.write_command(UI_CMD_CLIP_PUSH, nx, ny, nw, nh, 0, 0, 0, 0, 0, "")

    fun pop_clip(self):
        if self.clip_top <= 0:
            return
        self.clip_top = self.clip_top - 1
        if self.clip_top <= 0:
            self.write_command(UI_CMD_CLIP_POP, 0, 0, 0, 0, 0, 0, 0, 0, 0, "")
            return
        off: i64 = ((self.clip_top - 1) as i64) * 4
        self.write_command(
            UI_CMD_CLIP_PUSH,
            Memory.read_i32(self.clip_xs + off),
            Memory.read_i32(self.clip_ys + off),
            Memory.read_i32(self.clip_ws + off),
            Memory.read_i32(self.clip_hs + off),
            0, 0, 0, 0, 0, ""
        )

    fun render(self, canvas: DrawCanvas):
        if self.has_storage() == 0:
            return

        i: i32 = 0
        off32: i64 = 0
        off64: i64 = 0
        kind: i32 = 0
        x: i32 = 0
        y: i32 = 0
        width: i32 = 0
        height: i32 = 0
        x2: i32 = 0
        y2: i32 = 0
        color: UIColor = 0
        background: UIColor = 0
        thickness: i32 = 0
        value: str = ""

        while i < self.count:
            off32 = self.offset_i32(i)
            off64 = self.offset_i64(i)
            kind = Memory.read_i32(self.kinds + off32)
            x = Memory.read_i32(self.xs + off32)
            y = Memory.read_i32(self.ys + off32)
            width = Memory.read_i32(self.widths + off32)
            height = Memory.read_i32(self.heights + off32)
            x2 = Memory.read_i32(self.x2s + off32)
            y2 = Memory.read_i32(self.y2s + off32)
            color = Memory.read_i32(self.colors + off32)
            background = Memory.read_i32(self.backgrounds + off32)
            thickness = Memory.read_i32(self.thicknesses + off32)
            text_offset: i64 = Memory.read_i64(self.texts + off64)
            value = (self.text_data + text_offset) as str

            if kind == UI_CMD_CLEAR:
                canvas.clear(width, height, color)
            elif kind == UI_CMD_FILL_RECT:
                canvas.fill_rect(x, y, width, height, color)
            elif kind == UI_CMD_OUTLINE_RECT:
                canvas.outline_rect(x, y, width, height, color, thickness)
            elif kind == UI_CMD_LINE:
                canvas.line(x, y, x2, y2, color, thickness)
            elif kind == UI_CMD_TEXT:
                canvas.text(x, y, value, color)
            elif kind == UI_CMD_TEXT_BG:
                canvas.text_bg(x, y, value, color, background)
            elif kind == UI_CMD_FILL_CIRCLE:
                canvas.fill_circle(x, y, width, color)
            elif kind == UI_CMD_OUTLINE_CIRCLE:
                canvas.outline_circle(x, y, width, color, thickness)
            elif kind == UI_CMD_FILL_ROUNDED_RECT:
                canvas.fill_rounded_rect(x, y, width, height, x2, color)
            elif kind == UI_CMD_OUTLINE_ROUNDED_RECT:
                canvas.outline_rounded_rect(x, y, width, height, x2, color, thickness)
            elif kind == UI_CMD_CLIP_PUSH:
                canvas.set_clip(x, y, width, height)
            elif kind == UI_CMD_CLIP_POP:
                canvas.clear_clip()

            i = i + 1

    fun write_command(self, kind: i32, x: i32, y: i32, width: i32, height: i32, x2: i32, y2: i32, color: UIColor, background: UIColor, thickness: i32, value: str):
        if self.has_storage() == 0:
            self.dropped = self.dropped + 1
            return
        if self.ensure_capacity(self.count + 1) == 0:
            self.dropped = self.dropped + 1
            return

        off32: i64 = self.offset_i32(self.count)
        off64: i64 = self.offset_i64(self.count)
        text_offset: i64 = 0
        if kind == UI_CMD_TEXT or kind == UI_CMD_TEXT_BG:
            text_offset = self.store_text(value)
            if text_offset < 0:
                self.dropped = self.dropped + 1
                return
        Memory.write_i32(self.kinds + off32, kind)
        Memory.write_i32(self.xs + off32, x)
        Memory.write_i32(self.ys + off32, y)
        Memory.write_i32(self.widths + off32, width)
        Memory.write_i32(self.heights + off32, height)
        Memory.write_i32(self.x2s + off32, x2)
        Memory.write_i32(self.y2s + off32, y2)
        Memory.write_i32(self.colors + off32, color)
        Memory.write_i32(self.backgrounds + off32, background)
        Memory.write_i32(self.thicknesses + off32, thickness)
        Memory.write_i64(self.texts + off64, text_offset)
        self.count = self.count + 1

    fun ensure_capacity(self, required: i32) -> i32:
        if required <= self.capacity:
            return 1
        next_capacity: i32 = self.capacity * 2
        if next_capacity < 32:
            next_capacity = 32
        while next_capacity < required:
            next_capacity = next_capacity * 2
        bytes32: i64 = (next_capacity as i64) * 4
        bytes64: i64 = (next_capacity as i64) * 8
        next: i64 = Memory.realloc(self.kinds, bytes32)
        if next == 0:
            return 0
        self.kinds = next
        next = Memory.realloc(self.xs, bytes32)
        if next == 0:
            return 0
        self.xs = next
        next = Memory.realloc(self.ys, bytes32)
        if next == 0:
            return 0
        self.ys = next
        next = Memory.realloc(self.widths, bytes32)
        if next == 0:
            return 0
        self.widths = next
        next = Memory.realloc(self.heights, bytes32)
        if next == 0:
            return 0
        self.heights = next
        next = Memory.realloc(self.x2s, bytes32)
        if next == 0:
            return 0
        self.x2s = next
        next = Memory.realloc(self.y2s, bytes32)
        if next == 0:
            return 0
        self.y2s = next
        next = Memory.realloc(self.colors, bytes32)
        if next == 0:
            return 0
        self.colors = next
        next = Memory.realloc(self.backgrounds, bytes32)
        if next == 0:
            return 0
        self.backgrounds = next
        next = Memory.realloc(self.thicknesses, bytes32)
        if next == 0:
            return 0
        self.thicknesses = next
        next = Memory.realloc(self.texts, bytes64)
        if next == 0:
            return 0
        self.texts = next
        self.capacity = next_capacity
        return 1

    fun ensure_text_capacity(self, required: i64) -> i32:
        if required <= self.text_capacity:
            return 1
        next_capacity: i64 = self.text_capacity * 2
        if next_capacity < 256:
            next_capacity = 256
        while next_capacity < required:
            next_capacity = next_capacity * 2
        next: i64 = Memory.realloc(self.text_data, next_capacity)
        if next == 0:
            return 0
        self.text_data = next
        self.text_capacity = next_capacity
        return 1

    fun store_text(self, value: str) -> i64:
        length: i64 = Memory.strlen(value)
        required: i64 = self.text_used + length + 1
        if self.ensure_text_capacity(required) == 0:
            return 0 - 1
        offset: i64 = self.text_used
        if length > 0:
            Memory.copy(self.text_data + offset, value as i64, length)
        Memory.write_i8(self.text_data + offset + length, 0)
        self.text_used = required
        return offset

    fun ensure_clip_capacity(self, required: i32) -> i32:
        if required <= self.clip_capacity:
            return 1
        next_capacity: i32 = self.clip_capacity * 2
        if next_capacity < 16:
            next_capacity = 16
        while next_capacity < required:
            next_capacity = next_capacity * 2
        bytes: i64 = (next_capacity as i64) * 4
        next: i64 = Memory.realloc(self.clip_xs, bytes)
        if next == 0:
            return 0
        self.clip_xs = next
        next = Memory.realloc(self.clip_ys, bytes)
        if next == 0:
            return 0
        self.clip_ys = next
        next = Memory.realloc(self.clip_ws, bytes)
        if next == 0:
            return 0
        self.clip_ws = next
        next = Memory.realloc(self.clip_hs, bytes)
        if next == 0:
            return 0
        self.clip_hs = next
        self.clip_capacity = next_capacity
        return 1

    fun has_storage(self) -> i32:
        if self.capacity <= 0:
            return 0
        if self.kinds == 0:
            return 0
        if self.xs == 0:
            return 0
        if self.ys == 0:
            return 0
        if self.widths == 0:
            return 0
        if self.heights == 0:
            return 0
        if self.x2s == 0:
            return 0
        if self.y2s == 0:
            return 0
        if self.colors == 0:
            return 0
        if self.backgrounds == 0:
            return 0
        if self.thicknesses == 0:
            return 0
        if self.texts == 0:
            return 0
        if self.text_data == 0:
            return 0
        if self.clip_xs == 0 or self.clip_ys == 0 or self.clip_ws == 0 or self.clip_hs == 0:
            return 0
        return 1

    fun offset_i32(self, index: i32) -> i64:
        return (index * 4) as i64

    fun offset_i64(self, index: i32) -> i64:
        return (index * 8) as i64

fun ui_draw_list_create(capacity: i32) -> UIDrawList:
    return UIDrawList.create(capacity)
