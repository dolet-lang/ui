# UI Module Metadata
# Pure software UI + 2D drawing library for Dolet.

[info]
name = ui
version = 0.7.0
description = Pure-Dolet UI core. Owned or wrapped software surfaces, bitmap text, drawing primitives, safe growable command recording, clipping, and platform-neutral input snapshots.

[dependencies]
fonts

[link.windows]
# No platform libraries. Presentation belongs to the application layer.

[link.linux]
# No platform libraries.

[link.baremetal]
# No system libs needed.
