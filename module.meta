# UI Module Metadata
# Pure software UI + 2D drawing library for Dolet.

[info]
name = ui
version = 0.9.0
description = Pure-Dolet UI core with proportional coverage-font text, anti-aliased vector primitives, owned or wrapped surfaces, safe growable command recording, clipping, and platform-neutral input snapshots.

[dependencies]
fonts

[link.windows]
# No platform libraries. Presentation belongs to the application layer.

[link.linux]
# No platform libraries.

[link.baremetal]
# No system libs needed.
