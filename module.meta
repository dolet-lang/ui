# UI Module Metadata
# Pure software UI + 2D drawing library for Dolet.

[info]
name = ui
version = 0.13.0
layer = pure
description = Pure-Dolet UI core that shapes and reorders text on its way to the pixels, with UTF-8 proportional coverage-font text across Latin and Arabic glyph blocks, anti-aliased vector primitives, owned or wrapped surfaces, safe growable command recording, clipping, and platform-neutral input snapshots including directional and line-extent keys.

[dependencies]
unicode
text
fonts

[link.windows]
# No platform libraries. Presentation belongs to the application layer.

[link.linux]
# No platform libraries.

[link.baremetal]
# No system libs needed.
