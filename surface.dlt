# ============================
#  UI software surface
# ============================
# Owns (or wraps) a BGRA8 framebuffer and the default coverage font. It is
# intentionally unaware of windows, swapchains, or operating systems.

# Strings longer than this draw without the script pass. A label, a cell or
# a button caption is far below it, and the limit keeps the draw loop free
# of allocation.
UI_TEXT_SCRATCH_BYTES: i64 = 1024

struct UISurface:
    pixels: i64 = 0
    width: i32 = 0
    height: i32 = 0
    pitch: i32 = 0
    font: i64 = 0
    font_width: i32 = 0
    font_height: i32 = 0
    font_advance: i32 = 0
    font_line_height: i32 = 0
    font_first_codepoint: i32 = 0
    font_second_first: i32 = 0
    font_second_count: i32 = 0
    # Script-aware text: one scratch buffer, grown on demand and reused, so
    # preparing a string costs no allocation inside a frame.
    text_scratch: i64 = 0
    text_scratch_slots: i32 = 0
    text_out: i64 = 0
    text_out_bytes: i64 = 0
    text_shaping: i32 = 1
    font_glyph_count: i32 = 0
    font_glyph_stride: i32 = 0
    font_format: i32 = 0
    font_advances: i64 = 0
    # Everything the atlas knows beyond a bitmap: the subpixel phases it was
    # rasterised at, fractional advances, and the pair table kerning needs.
    font_phases: i32 = 1
    font_advances_q8: i64 = 0
    font_glyph_ids: i64 = 0
    font_kern_keys: i64 = 0
    font_kern_values: i64 = 0
    font_kern_count: i32 = 0
    owns_pixels: i32 = 0
    owns_font: i32 = 0
    valid: i32 = 0

attach UISurface:
    static fun create(width: i32, height: i32) -> UISurface:
        surface: UISurface = UISurface()
        if width <= 0 or height <= 0:
            return surface
        size: i64 = (width as i64) * (height as i64) * 4
        surface.pixels = Memory.malloc(size)
        if surface.pixels == 0:
            return surface
        face: FontFace = font_face_basic_smooth(14)
        if face.is_valid() == 0:
            Memory.free(surface.pixels)
            surface.pixels = 0
            return surface
        surface.adopt_font_face(face)
        surface.width = width
        surface.height = height
        surface.pitch = width * 4
        surface.owns_pixels = 1
        surface.owns_font = 1
        surface.reserve_text_scratch(UI_TEXT_SCRATCH_BYTES)
        surface.valid = 1
        return surface

    static fun wrap(pixels: i64, width: i32, height: i32, pitch: i32) -> UISurface:
        surface: UISurface = UISurface()
        if pixels == 0 or width <= 0 or height <= 0:
            return surface
        if pitch < width * 4:
            return surface
        face: FontFace = font_face_basic_smooth(14)
        if face.is_valid() == 0:
            return surface
        surface.adopt_font_face(face)
        surface.pixels = pixels
        surface.width = width
        surface.height = height
        surface.pitch = pitch
        surface.owns_pixels = 0
        surface.owns_font = 1
        surface.valid = 1
        return surface

    fun is_valid(self) -> i32:
        return self.valid

    fun resize(self, width: i32, height: i32) -> i32:
        if width <= 0 or height <= 0:
            return 0
        if self.owns_pixels == 0:
            if width == self.width and height == self.height:
                return self.valid
            return 0
        if self.valid == 1 and width == self.width and height == self.height:
            return 1
        size: i64 = (width as i64) * (height as i64) * 4
        next_pixels: i64 = Memory.realloc(self.pixels, size)
        if next_pixels == 0:
            return 0
        self.pixels = next_pixels
        self.width = width
        self.height = height
        self.pitch = width * 4
        self.valid = 1
        return 1

    fun canvas(self) -> DrawCanvas:
        if self.valid == 0:
            return draw_canvas_empty()
        made: DrawCanvas = draw_canvas_from_font_face_ranges(self.pixels, self.width, self.height, self.pitch, self.font, self.font_width, self.font_height, self.font_advance, self.font_line_height, self.font_first_codepoint, self.font_glyph_count, self.font_glyph_stride, self.font_format, self.font_advances, self.font_second_first, self.font_second_count)
        made.set_font_subpixel(self.font_phases, self.font_advances_q8, self.font_glyph_ids, self.font_kern_keys, self.font_kern_values, self.font_kern_count)
        made.set_text_scratch(self.text_scratch, self.text_scratch_slots, self.text_out, self.text_out_bytes, self.text_shaping)
        return made

    # Whether text is put through the script pipeline before it is drawn or
    # measured. On by default. Turn it off to draw exactly the codepoints
    # given, which is what an application that prepared them itself wants.
    fun set_text_shaping(self, enabled: i32):
        self.text_shaping = enabled

    # Size the shared scratch for strings up to `bytes` long. Called once when
    # the surface is created; an application drawing unusually long strings
    # can call it again on a surface it owns directly.
    #
    # It is deliberately NOT called from the drawing path. Preparing text runs
    # for every string of every frame, and allocating there would put a malloc
    # in the draw loop; a string longer than the scratch simply draws
    # unprepared rather than growing it mid-frame.
    fun reserve_text_scratch(self, bytes: i64) -> i32:
        needed_slots: i32 = ((bytes + 1) as i32) * 7
        needed_out: i64 = bytes * 4 + 8
        if self.text_scratch != 0 and self.text_scratch_slots >= needed_slots and self.text_out_bytes >= needed_out:
            return 1
        next_slots: i32 = needed_slots * 2
        next_out: i64 = needed_out * 2
        scratch: i64 = Memory.malloc_zeroed((next_slots as i64) * 4)
        if scratch == 0:
            return 0
        out: i64 = Memory.malloc_zeroed(next_out)
        if out == 0:
            Memory.free(scratch)
            return 0
        if self.text_scratch != 0:
            Memory.free(self.text_scratch)
        if self.text_out != 0:
            Memory.free(self.text_out)
        self.text_scratch = scratch
        self.text_scratch_slots = next_slots
        self.text_out = out
        self.text_out_bytes = next_out
        return 1

    # The string as it will be drawn. Latin returns unchanged after one walk
    # over the bytes; anything the pipeline would reorder is prepared into
    # the shared buffer.
    fun prepare_text(self, value: str) -> str:
        if self.text_shaping == 0:
            return value
        if text_needs_display_pass(value) == 0:
            return value
        if text_display_str_into(value, self.text_out, self.text_out_bytes, self.text_scratch, self.text_scratch_slots) < 0:
            return value
        return self.text_out as str

    # Summed in 1/256 of a pixel, kerned, and rounded once at the end.
    #
    # Rounding each glyph and adding the results is the same arithmetic the
    # pen deliberately avoids, and the two must not disagree: a label centred
    # from one width and drawn by the other sits visibly off, and a caret
    # placed that way drifts a little further with every character.
    fun text_width(self, value: string) -> i32:
        return (self.text_width_q8(value) + 128) / 256

    fun text_width_q8(self, value: string) -> i32:
        if self.font == 0:
            return 0
        shown: str = self.prepare_text(value)
        limit: i64 = Memory.strlen(shown)
        bytes: i64 = shown as i64
        offset: i64 = 0
        width: i32 = 0
        ch: Utf8Char = Utf8Char()
        advance: i32 = 0
        previous: i32 = 0
        while offset < limit:
            ch = utf8_decode(bytes, offset, limit)
            if ch.size <= 0:
                return width
            advance = self.codepoint_width_q8(ch.codepoint)
            if advance > 0:
                if previous != 0:
                    width = width + self.codepoint_kern_q8(previous, ch.codepoint)
                previous = ch.codepoint
            offset = offset + (ch.size as i64)
            width = width + advance
        return width

    # Advance of a single codepoint. A caret walking a shaped, reordered line
    # needs per-glyph widths; measuring whole strings cannot give them.
    fun codepoint_width(self, codepoint: i32) -> i32:
        return (self.codepoint_width_q8(codepoint) + 128) / 256

    # The same, in 1/256 of a pixel. A caret placed from rounded widths drifts
    # away from the glyphs it is meant to sit between, one glyph at a time.
    fun codepoint_width_q8(self, codepoint: i32) -> i32:
        if self.font == 0:
            return 0
        slot: i32 = self.font_glyph_slot(codepoint)
        if slot >= 0:
            if self.font_advances_q8 != 0:
                return Memory.read_i32(self.font_advances_q8 + (slot as i64) * 4)
            if self.font_advances != 0:
                return Memory.read_i32(self.font_advances + (slot as i64) * 4) * 256
        if unicode_bidi_class(codepoint) == BIDI_NSM:
            return 0
        return self.font_advance * 256

    # The kern between two codepoints, in 1/256 of a pixel.
    fun codepoint_kern_q8(self, left: i32, right: i32) -> i32:
        if self.font_kern_count <= 0:
            return 0
        if self.font_glyph_ids == 0:
            return 0
        left_slot: i32 = self.font_glyph_slot(left)
        right_slot: i32 = self.font_glyph_slot(right)
        if left_slot < 0:
            return 0
        if right_slot < 0:
            return 0
        left_glyph: i32 = Memory.read_i32(self.font_glyph_ids + (left_slot as i64) * 4)
        right_glyph: i32 = Memory.read_i32(self.font_glyph_ids + (right_slot as i64) * 4)
        if left_glyph <= 0:
            return 0
        if right_glyph <= 0:
            return 0
        want: i64 = ((left_glyph as i64) << 32) | (right_glyph as i64)
        low: i32 = 0
        high: i32 = self.font_kern_count - 1
        mid: i32 = 0
        key: i64 = 0
        while low <= high:
            mid = (low + high) / 2
            key = Memory.read_i64(self.font_kern_keys + (mid as i64) * 8)
            if key == want:
                return Memory.read_i32(self.font_kern_values + (mid as i64) * 4)
            elif key < want:
                low = mid + 1
            else:
                high = mid - 1
        return 0

    # Atlas index for a codepoint across both blocks, or -1.
    fun font_glyph_slot(self, codepoint: i32) -> i32:
        index: i32 = codepoint - self.font_first_codepoint
        if index >= 0 and index < self.font_glyph_count:
            return index
        if self.font_second_count > 0:
            index = codepoint - self.font_second_first
            if index >= 0 and index < self.font_second_count:
                return self.font_glyph_count + index
        return 0 - 1

    fun text_height(self) -> i32:
        return self.font_line_height

    # Replace the built-in face with one at a different pixel height, owned
    # by the surface. A display at twice the density needs a face at twice
    # the size; asking the caller to build one would make every application
    # carry the knowledge.
    fun use_default_font(self, pixel_height: i32) -> i32:
        face: FontFace = font_face_basic_smooth(pixel_height)
        if face.is_valid() == 0:
            return 0
        self.adopt_font_face(face)
        self.owns_font = 1
        return 1

    # Borrow a face owned by the caller. The face must stay alive until it is
    # replaced or the surface is destroyed. This makes runtime font switching
    # allocation-free and avoids ambiguous shared ownership.
    fun use_font_face(self, face: FontFace) -> i32:
        if face.is_valid() == 0:
            return 0
        if self.owns_font == 1 and self.font != 0:
            Memory.free(self.font)
        self.font = face.pixels
        self.font_width = face.glyph_width
        self.font_height = face.glyph_height
        self.font_advance = face.advance_x
        self.font_line_height = face.line_height
        self.font_first_codepoint = face.first_codepoint
        self.font_second_first = face.second_first
        self.font_second_count = face.second_count
        self.font_glyph_count = face.glyph_count
        self.font_glyph_stride = face.glyph_stride
        self.font_format = face.format
        self.font_advances = face.glyph_advances
        self.font_phases = face.phases
        self.font_advances_q8 = face.advances_q8
        self.font_glyph_ids = face.glyph_ids
        self.font_kern_keys = face.kern_keys
        self.font_kern_values = face.kern_values
        self.font_kern_count = face.kern_count
        self.owns_font = 0
        return 1

    # Transfer pixel ownership to the surface. The caller must not destroy the
    # original face after this call.
    fun adopt_font_face(self, face: FontFace):
        if self.owns_font == 1 and self.font != 0:
            Memory.free(self.font)
        self.font = face.pixels
        self.font_width = face.glyph_width
        self.font_height = face.glyph_height
        self.font_advance = face.advance_x
        self.font_line_height = face.line_height
        self.font_first_codepoint = face.first_codepoint
        self.font_second_first = face.second_first
        self.font_second_count = face.second_count
        self.font_glyph_count = face.glyph_count
        self.font_glyph_stride = face.glyph_stride
        self.font_format = face.format
        self.font_advances = face.glyph_advances
        self.font_phases = face.phases
        self.font_advances_q8 = face.advances_q8
        self.font_glyph_ids = face.glyph_ids
        self.font_kern_keys = face.kern_keys
        self.font_kern_values = face.kern_values
        self.font_kern_count = face.kern_count
        self.owns_font = face.owns_pixels

    fun destroy(self):
        if self.owns_pixels == 1 and self.pixels != 0:
            Memory.free(self.pixels)
        if self.owns_font == 1 and self.font != 0:
            Memory.free(self.font)
        if self.text_scratch != 0:
            Memory.free(self.text_scratch)
        if self.text_out != 0:
            Memory.free(self.text_out)
        self.text_scratch = 0
        self.text_scratch_slots = 0
        self.text_out = 0
        self.text_out_bytes = 0
        self.pixels = 0
        self.width = 0
        self.height = 0
        self.pitch = 0
        self.font = 0
        self.font_width = 0
        self.font_height = 0
        self.font_advance = 0
        self.font_line_height = 0
        self.font_first_codepoint = 0
        self.font_second_first = 0
        self.font_second_count = 0
        self.font_glyph_count = 0
        self.font_glyph_stride = 0
        self.font_format = 0
        self.font_advances = 0
        self.font_phases = 1
        self.font_advances_q8 = 0
        self.font_glyph_ids = 0
        self.font_kern_keys = 0
        self.font_kern_values = 0
        self.font_kern_count = 0
        self.owns_pixels = 0
        self.owns_font = 0
        self.valid = 0

fun ui_surface_create(width: i32, height: i32) -> UISurface:
    # Built once and shared; see the gamma tables in canvas.
    ui_gamma_ready()
    return UISurface.create(width, height)

fun ui_surface_wrap(pixels: i64, width: i32, height: i32, pitch: i32) -> UISurface:
    return UISurface.wrap(pixels, width, height, pitch)
