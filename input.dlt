# ============================
#  Platform-neutral UI input snapshots
# ============================
# Native frameworks collect OS events and feed one snapshot per frame. The
# renderer and widgets never query a window system directly.

struct UIMouseState:
    x: i32 = 0
    y: i32 = 0
    previous_x: i32 = 0
    previous_y: i32 = 0
    left_down: i32 = 0
    right_down: i32 = 0
    middle_down: i32 = 0
    previous_left_down: i32 = 0
    previous_right_down: i32 = 0
    previous_middle_down: i32 = 0
    wheel_x: f32 = 0.0
    wheel_y: f32 = 0.0

attach UIMouseState:
    static fun create() -> UIMouseState:
        return UIMouseState()

    fun begin_frame(self, x: i32, y: i32, left_down: i32, right_down: i32, middle_down: i32, wheel_x: f32, wheel_y: f32):
        self.previous_x = self.x
        self.previous_y = self.y
        self.previous_left_down = self.left_down
        self.previous_right_down = self.right_down
        self.previous_middle_down = self.middle_down
        self.x = x
        self.y = y
        self.left_down = left_down
        self.right_down = right_down
        self.middle_down = middle_down
        self.wheel_x = wheel_x
        self.wheel_y = wheel_y

    fun delta_x(self) -> i32:
        return self.x - self.previous_x

    fun delta_y(self) -> i32:
        return self.y - self.previous_y

    fun left_pressed(self) -> i32:
        if self.left_down == 1 and self.previous_left_down == 0:
            return 1
        return 0

    fun left_released(self) -> i32:
        if self.left_down == 0 and self.previous_left_down == 1:
            return 1
        return 0

    fun right_pressed(self) -> i32:
        if self.right_down == 1 and self.previous_right_down == 0:
            return 1
        return 0

    fun right_released(self) -> i32:
        if self.right_down == 0 and self.previous_right_down == 1:
            return 1
        return 0

    fun middle_pressed(self) -> i32:
        if self.middle_down == 1 and self.previous_middle_down == 0:
            return 1
        return 0

    fun middle_released(self) -> i32:
        if self.middle_down == 0 and self.previous_middle_down == 1:
            return 1
        return 0

    fun left_dragging(self) -> i32:
        return self.left_down

    fun is_over(self, rect: UIRect) -> i32:
        return ui_rect_contains(rect, self.x, self.y)

    fun is_over_xy(self, x: i32, y: i32, width: i32, height: i32) -> i32:
        return ui_rect_contains_xy(x, y, width, height, self.x, self.y)

struct UIInputState:
    mouse: UIMouseState = UIMouseState()
    typed_chars: str = ""
    backspace: i32 = 0
    delete_pressed: i32 = 0
    enter_pressed: i32 = 0
    tab_pressed: i32 = 0
    escape_pressed: i32 = 0
    shift_down: i32 = 0
    ctrl_down: i32 = 0
    alt_down: i32 = 0
    # Directional keys. A framework that offers keyboard focus needs these to
    # move within a widget (a slider's value, a list's selection) as opposed
    # to between widgets, which is what tab_pressed is for.
    left_pressed: i32 = 0
    right_pressed: i32 = 0
    up_pressed: i32 = 0
    down_pressed: i32 = 0
    # Line-extent keys. A caret needs these as much as it needs the arrows.
    home_pressed: i32 = 0
    end_pressed: i32 = 0

attach UIInputState:
    static fun create() -> UIInputState:
        return UIInputState()

    fun begin_frame(self, x: i32, y: i32, left_down: i32, right_down: i32, middle_down: i32, wheel_x: f32, wheel_y: f32, typed_chars: str, backspace: i32):
        self.mouse.begin_frame(x, y, left_down, right_down, middle_down, wheel_x, wheel_y)
        self.typed_chars = typed_chars
        self.backspace = backspace
        self.delete_pressed = 0
        self.enter_pressed = 0
        self.tab_pressed = 0
        self.escape_pressed = 0
        self.left_pressed = 0
        self.right_pressed = 0
        self.up_pressed = 0
        self.down_pressed = 0
        self.home_pressed = 0
        self.end_pressed = 0

    fun set_navigation(self, delete_pressed: i32, enter_pressed: i32, tab_pressed: i32, escape_pressed: i32, shift_down: i32, ctrl_down: i32, alt_down: i32):
        self.delete_pressed = delete_pressed
        self.enter_pressed = enter_pressed
        self.tab_pressed = tab_pressed
        self.escape_pressed = escape_pressed
        self.shift_down = shift_down
        self.ctrl_down = ctrl_down
        self.alt_down = alt_down

    # Separate from set_navigation so existing callers keep compiling; both
    # are one-shot and cleared by begin_frame.
    fun set_arrows(self, left: i32, right: i32, up: i32, down: i32):
        self.left_pressed = left
        self.right_pressed = right
        self.up_pressed = up
        self.down_pressed = down

    fun set_edit_keys(self, home: i32, line_end: i32):
        self.home_pressed = home
        self.end_pressed = line_end

fun ui_mouse_create() -> UIMouseState:
    return UIMouseState.create()

fun ui_input_create() -> UIInputState:
    return UIInputState.create()
