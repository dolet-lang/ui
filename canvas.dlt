# ============================
#  Draw — Canvas (software framebuffer)
# ============================
# Pure Memory.write_i32 drawing. A DrawCanvas wraps pixels supplied by a
# UISurface; it never owns a native window and never presents by itself.
#
# All drawing is inlined inside DrawCanvas methods to avoid a DLT sret
# codegen bug when struct-returning calls appear inside imple methods.

struct DrawCanvas:
    fb_data:     i64 = 0 as i64
    width:       i32 = 0
    height:      i32 = 0
    fb_pitch:    i32 = 0
    fb_valid:    i32 = 0
    font:        i64 = 0 as i64
    font_width:  i32 = 8
    font_height: i32 = 8
    font_advance:i32 = 8
    font_line_height: i32 = 8
    font_first:  i32 = 32
    font_count:  i32 = 95
    # A second glyph block, following the first in the same atlas.
    font_first2: i32 = 0
    font_count2: i32 = 0
    # Working space for script-aware text, borrowed from the surface so the
    # draw loop never allocates.
    text_scratch: i64 = 0
    text_scratch_slots: i32 = 0
    text_out: i64 = 0
    text_out_bytes: i64 = 0
    text_shaping: i32 = 0
    font_stride: i32 = 8
    font_format: i32 = 0
    font_advances: i64 = 0 as i64
    clip_x:      i32 = 0
    clip_y:      i32 = 0
    clip_w:      i32 = 0
    clip_h:      i32 = 0
    clip_active: i32 = 0
    font_medium: i64 = 0 as i64

# Sine of an angle in degrees, scaled by 1024.
#
# Bhaskara's approximation rather than a table: it is two multiplies and a
# divide, it is exact at 0, 30, 90, 150 and 180, and it is never off by more
# than a fifth of a degree's worth anywhere else — far below what a rasteriser
# can show. A framework that will not link libm has to bring its own, and a
# table of 91 entries would cost more to carry than this costs to compute.
fun draw_sin_q10(degrees: i32) -> i32:
    d: i32 = degrees % 360
    if d < 0:
        d = d + 360
    sign: i32 = 1
    if d > 180:
        d = d - 180
        sign = 0 - 1
    span: i64 = (d as i64) * (180 - (d as i64))
    denominator: i64 = 40500 - span
    if denominator <= 0:
        return 0
    return ((4 * span * 1024) / denominator) as i32 * sign

fun draw_cos_q10(degrees: i32) -> i32:
    return draw_sin_q10(degrees + 90)

fun draw_canvas_empty() -> DrawCanvas:
    return DrawCanvas()

# ----- Integer helpers -----

# Integer square root via Newton's method. Returns floor(sqrt(n)).
fun draw_isqrt(n: i32) -> i32:
    if n <= 0:
        return 0
    x: i32 = n
    y: i32 = (x + 1) / 2
    while y < x:
        x = y
        y = (x + n / x) / 2
    return x

# Fractional integer sqrt in Q8.8 fixed point: returns floor(sqrt(n) * 256).
# Used for the sub-pixel coverage math in AA circle edges.
fun draw_isqrt_q8(n: i32) -> i32:
    if n <= 0:
        return 0
    big: i64 = (n as i64) * 65536
    # Newton on the scaled value (big) — result is sqrt(n)*256.
    x: i64 = big
    y: i64 = (x + 1) / 2
    while y < x:
        x = y
        y = (x + big / x) / 2
    return x as i32

# 4x4 ordered sub-pixel coverage for circular boundaries. Only edge/corner
# pixels call this helper; solid interiors still use fast span fills.
fun draw_circle_coverage_q8(dx_q8: i32, dy_q8: i32, outer_q8: i32, inner_q8: i32) -> i32:
    outer2: i64 = (outer_q8 as i64) * (outer_q8 as i64)
    inner2: i64 = (inner_q8 as i64) * (inner_q8 as i64)
    samples: i32 = 0
    sy: i32 = 0
    sx: i32 = 0
    ox: i32 = 0
    oy: i32 = 0
    px: i64 = 0
    py: i64 = 0
    distance2: i64 = 0
    while sy < 4:
        oy = -96 + sy * 64
        sx = 0
        while sx < 4:
            ox = -96 + sx * 64
            px = (dx_q8 + ox) as i64
            py = (dy_q8 + oy) as i64
            distance2 = px * px + py * py
            if distance2 <= outer2:
                if inner_q8 <= 0 or distance2 >= inner2:
                    samples = samples + 1
            sx = sx + 1
        sy = sy + 1
    return (samples * 255 + 8) / 16

# Coverage of a round-capped line segment at one pixel. Coordinates are sampled
# in Q8 fixed point so the hot path stays platform-neutral and deterministic.
fun draw_line_coverage_q8(pixel_x: i32, pixel_y: i32, x1: i32, y1: i32, x2: i32, y2: i32, radius_q8: i32) -> i32:
    vx: i64 = (x2 - x1) as i64
    vy: i64 = (y2 - y1) as i64
    length2: i64 = vx * vx + vy * vy
    radius2: i64 = (radius_q8 as i64) * (radius_q8 as i64)
    samples: i32 = 0
    sy: i32 = 0
    sx: i32 = 0
    ox: i32 = 0
    oy: i32 = 0
    px_q8: i64 = 0
    py_q8: i64 = 0
    dx_q8: i64 = 0
    dy_q8: i64 = 0
    dot_q8: i64 = 0
    t_q8: i64 = 0
    closest_x: i64 = 0
    closest_y: i64 = 0
    distance_x: i64 = 0
    distance_y: i64 = 0
    distance2: i64 = 0
    while sy < 4:
        oy = -96 + sy * 64
        sx = 0
        while sx < 4:
            ox = -96 + sx * 64
            px_q8 = (pixel_x as i64) * 256 + (ox as i64)
            py_q8 = (pixel_y as i64) * 256 + (oy as i64)
            if length2 == 0:
                closest_x = (x1 as i64) * 256
                closest_y = (y1 as i64) * 256
            else:
                dx_q8 = px_q8 - (x1 as i64) * 256
                dy_q8 = py_q8 - (y1 as i64) * 256
                dot_q8 = dx_q8 * vx + dy_q8 * vy
                t_q8 = dot_q8 / length2
                if t_q8 < 0:
                    t_q8 = 0
                if t_q8 > 256:
                    t_q8 = 256
                closest_x = (x1 as i64) * 256 + vx * t_q8
                closest_y = (y1 as i64) * 256 + vy * t_q8
            distance_x = px_q8 - closest_x
            distance_y = py_q8 - closest_y
            distance2 = distance_x * distance_x + distance_y * distance_y
            if distance2 <= radius2:
                samples = samples + 1
            sx = sx + 1
        sy = sy + 1
    return (samples * 255 + 8) / 16

attach DrawCanvas:
    fun glyph_advance(self, glyph_index: i32) -> i32:
        # The bound is both blocks. Stopping at font_count sent every glyph in
        # the second block to the fallback advance, which spaced Arabic as if
        # each joined form were a full-width Latin letter and pulled the
        # cursive connections apart.
        if glyph_index < 0 or glyph_index >= self.font_count + self.font_count2 or self.font_advances == 0:
            return self.font_advance
        return Memory.read_i32(self.font_advances + (glyph_index as i64) * 4)

    # Atlas index for a codepoint, or -1 when the face has no glyph for it.
    fun font_glyph_index(self, codepoint: i32) -> i32:
        index: i32 = codepoint - self.font_first
        if index >= 0 and index < self.font_count:
            return index
        if self.font_count2 > 0:
            index = codepoint - self.font_first2
            if index >= 0 and index < self.font_count2:
                return self.font_count + index
        return 0 - 1

    # Width to move the pen by for one character. A non-spacing mark the face
    # has no glyph for takes NO space: it is a diacritic that belongs on top
    # of the letter before it, so charging it a fallback advance would open a
    # hole in the middle of a word instead of quietly omitting an accent.
    fun advance_for(self, codepoint: i32, glyph_index: i32) -> i32:
        # A non-spacing mark takes no width, glyph or no glyph. The Arabic
        # presentation forms carry an advance because that block was designed
        # to be usable standalone, but a fatha on a letter is not standing
        # alone: charging it a width would push the word apart around it.
        if unicode_bidi_class(codepoint) == BIDI_NSM:
            return 0
        if glyph_index >= 0:
            return self.glyph_advance(glyph_index)
        return self.font_advance

    # Blit a pixel buffer into a rectangle, sampling nearest when the two
    # differ in size. The source is in the surface's own channel order: the
    # conversion happens once when an image is taken in, not per pixel per
    # frame.
    #
    # A tint of 0 draws the image as it is; anything else multiplies each
    # channel, which is what turns one white icon into a themed one.
    fun image(self, x: i32, y: i32, width: i32, height: i32, pixels: i64, src_w: i32, src_h: i32, src_stride: i32, tint: DrawColor):
        if self.fb_valid == 0 or pixels == 0:
            return
        if width <= 0 or height <= 0 or src_w <= 0 or src_h <= 0:
            return
        tinted: i32 = 0
        tr: i32 = 255
        tg: i32 = 255
        tb: i32 = 255
        if tint != 0:
            tinted = 1
            tb = tint & 255
            tg = (tint >> 8) & 255
            tr = (tint >> 16) & 255

        dy: i32 = 0
        dx: i32 = 0
        px: i32 = 0
        py: i32 = 0
        sx: i32 = 0
        sy: i32 = 0
        source: i32 = 0
        alpha: i32 = 0
        blue: i32 = 0
        green: i32 = 0
        red: i32 = 0
        while dy < height:
            py = y + dy
            if py >= 0 and py < self.height:
                sy = (dy * src_h) / height
                dx = 0
                while dx < width:
                    px = x + dx
                    if px >= 0 and px < self.width:
                        if self.clip_active == 0 or (px >= self.clip_x and py >= self.clip_y and px < self.clip_x + self.clip_w and py < self.clip_y + self.clip_h):
                            sx = (dx * src_w) / width
                            source = Memory.read_i32(pixels + (sy as i64) * (src_stride as i64) + (sx as i64) * 4)
                            alpha = (source >> 24) & 255
                            if alpha > 0:
                                if tinted == 1:
                                    blue = ((source & 255) * tb) / 255
                                    green = (((source >> 8) & 255) * tg) / 255
                                    red = (((source >> 16) & 255) * tr) / 255
                                    source = (blue & 255) | ((green & 255) << 8) | ((red & 255) << 16) | (alpha << 24)
                                if alpha >= 255:
                                    Memory.write_i32(self.fb_data + (py as i64) * (self.fb_pitch as i64) + (px as i64) * 4, source)
                                else:
                                    self.blend_pixel(px, py, source, alpha)
                    dx = dx + 1
            dy = dy + 1

    fun set_text_scratch(self, scratch: i64, slots: i32, out: i64, out_bytes: i64, enabled: i32):
        self.text_scratch = scratch
        self.text_scratch_slots = slots
        self.text_out = out
        self.text_out_bytes = out_bytes
        self.text_shaping = enabled

    # Text as it should be drawn: cursive forms chosen and runs reordered.
    # Returns the string unchanged when nothing needs doing, which is the
    # common case and costs one walk over the bytes.
    fun prepare_text(self, value: str) -> str:
        if self.text_shaping == 0 or self.text_scratch == 0:
            return value
        if text_needs_display_pass(value) == 0:
            return value
        if text_display_str_into(value, self.text_out, self.text_out_bytes, self.text_scratch, self.text_scratch_slots) < 0:
            return value
        return self.text_out as str

    fun measure_text(self, value: str) -> i32:
        shown: str = self.prepare_text(value)
        text_ptr: i64 = shown as i64
        length: i32 = Memory.strlen(shown) as i32
        index: i32 = 0
        width: i32 = 0
        while index < length:
            codepoint: i32 = Memory.read_i8(text_ptr + (index as i64)) & 255
            width = width + self.advance_for(codepoint, self.font_glyph_index(codepoint))
            index = index + 1
        return width

    fun is_valid(self) -> i32:
        return self.fb_valid

    # Alpha-blend one pixel. alpha is 0..255 (0 = fully transparent,
    # 255 = fully opaque). Honours bounds and the clip rect. Used by
    # the AA line / circle primitives — not intended for hot loops
    # that don't need transparency (use Memory.write_i32 directly).
    fun blend_pixel(self, x: i32, y: i32, color: DrawColor, alpha: i32):
        if self.fb_valid == 0:
            return
        zero: i32 = self.fb_valid - self.fb_valid
        if x < zero:
            return
        if y < zero:
            return
        if x >= self.width:
            return
        if y >= self.height:
            return
        if self.clip_active == 1:
            if x < self.clip_x:
                return
            if y < self.clip_y:
                return
            if x >= self.clip_x + self.clip_w:
                return
            if y >= self.clip_y + self.clip_h:
                return
        source_alpha: i32 = (color >> 24) & 255
        effective_alpha: i32 = (alpha * source_alpha) / 255
        if effective_alpha <= zero:
            return
        addr: i64 = self.fb_data + (y as i64) * (self.fb_pitch as i64) + (x as i64) * 4
        if effective_alpha >= 255:
            Memory.write_i32(addr, color)
            return
        dst: i32 = Memory.read_i32(addr)
        sb: i32 = color & 255
        sg: i32 = (color >> 8) & 255
        sr: i32 = (color >> 16) & 255
        db: i32 = dst & 255
        dg: i32 = (dst >> 8) & 255
        dr: i32 = (dst >> 16) & 255
        inv: i32 = 255 - effective_alpha
        ob: i32 = (sb * effective_alpha + db * inv) / 255
        og: i32 = (sg * effective_alpha + dg * inv) / 255
        ored: i32 = (sr * effective_alpha + dr * inv) / 255
        Memory.write_i32(addr, (ob & 255) | ((og & 255) << 8) | ((ored & 255) << 16) | (255 << 24))

    fun end(self):
        # Kept as a harmless frame-boundary marker for callers migrating
        # from ui 0.6. Presentation belongs to eqoi or another host.
        return

    fun clear(self, width: i32, height: i32, color: DrawColor):
        if self.fb_valid == 0:
            return
        y: i32 = self.fb_valid - self.fb_valid
        x: i32 = self.fb_valid - self.fb_valid
        row: i64 = self.fb_valid as i64 - self.fb_valid as i64
        while y < self.height:
            row = self.fb_data + (y as i64) * (self.fb_pitch as i64)
            x = self.fb_valid - self.fb_valid
            while x < self.width:
                Memory.write_i32(row + (x as i64) * 4, color)
                x = x + 1
            y = y + 1

    fun fill_rect(self, x: i32, y: i32, width: i32, height: i32, color: DrawColor):
        if self.fb_valid == 0:
            return
        if width <= 0 or height <= 0:
            return
        start_x: i32 = x
        start_y: i32 = y
        end_x: i32 = x + width
        end_y: i32 = y + height
        zero: i32 = self.fb_valid - self.fb_valid
        if start_x < zero:
            start_x = zero
        if start_y < zero:
            start_y = zero
        if end_x > self.width:
            end_x = self.width
        if end_y > self.height:
            end_y = self.height
        # Intersect with clip rect if active
        if self.clip_active == 1:
            if start_x < self.clip_x:
                start_x = self.clip_x
            if start_y < self.clip_y:
                start_y = self.clip_y
            cx_end: i32 = self.clip_x + self.clip_w
            cy_end: i32 = self.clip_y + self.clip_h
            if end_x > cx_end:
                end_x = cx_end
            if end_y > cy_end:
                end_y = cy_end
        yy: i32 = start_y
        xx: i32 = zero
        row: i64 = zero as i64
        alpha: i32 = (color >> 24) & 255
        if alpha <= 0:
            return
        inv: i32 = 255 - alpha
        sb: i32 = color & 255
        sg: i32 = (color >> 8) & 255
        sr: i32 = (color >> 16) & 255
        while yy < end_y:
            row = self.fb_data + (yy as i64) * (self.fb_pitch as i64)
            xx = start_x
            while xx < end_x:
                addr: i64 = row + (xx as i64) * 4
                if alpha >= 255:
                    Memory.write_i32(addr, color)
                else:
                    dst: i32 = Memory.read_i32(addr)
                    db: i32 = dst & 255
                    dg: i32 = (dst >> 8) & 255
                    dr: i32 = (dst >> 16) & 255
                    ob: i32 = (sb * alpha + db * inv) / 255
                    og: i32 = (sg * alpha + dg * inv) / 255
                    ored: i32 = (sr * alpha + dr * inv) / 255
                    Memory.write_i32(addr, (ob & 255) | ((og & 255) << 8) | ((ored & 255) << 16) | (255 << 24))
                xx = xx + 1
            yy = yy + 1

    fun fill_square(self, x: i32, y: i32, size: i32, color: DrawColor):
        self.fill_rect(x, y, size, size, color)

    fun outline_rect(self, x: i32, y: i32, width: i32, height: i32, color: DrawColor, thickness: i32):
        if self.fb_valid == 0:
            return
        if width <= 0 or height <= 0:
            return
        t: i32 = thickness
        if t <= 0:
            t = self.fb_valid - self.fb_valid + 1
        # If thickness covers the whole rect, just fill it
        if t * 2 >= width or t * 2 >= height:
            self.fill_rect(x, y, width, height, color)
            return
        # Top strip
        self.fill_rect(x, y, width, t, color)
        # Bottom strip
        self.fill_rect(x, y + height - t, width, t, color)
        # Left strip (between top and bottom already filled)
        self.fill_rect(x, y + t, t, height - 2 * t, color)
        # Right strip
        self.fill_rect(x + width - t, y + t, t, height - 2 * t, color)

    fun line(self, x1: i32, y1: i32, x2: i32, y2: i32, color: DrawColor, thickness: i32):
        if self.fb_valid == 0:
            return
        zero: i32 = self.fb_valid - self.fb_valid
        t: i32 = thickness
        if t <= 0:
            t = zero + 1

        # ------------------------------------------------------------
        # Thick lines: draw a t×t block at each Bresenham step. AA on
        # thick lines is rarely useful visually and much more expensive.
        # ------------------------------------------------------------
        if t > 1:
            self._line_thick(x1, y1, x2, y2, color, t)
            return

        # ------------------------------------------------------------
        # Thin (1-px) line: Wu's anti-aliased algorithm.
        # Walk the major axis in integer steps; for each step, write
        # two pixels whose alpha sums to 1 (fractional coverage).
        # ------------------------------------------------------------
        dx_s: i32 = x2 - x1
        dy_s: i32 = y2 - y1
        adx: i32 = dx_s
        if adx < zero:
            adx = zero - adx
        ady: i32 = dy_s
        if ady < zero:
            ady = zero - ady

        # Horizontal / vertical → no AA needed; fall back to fill_rect.
        if ady == zero:
            xa: i32 = x1
            xb: i32 = x2
            if xa > xb:
                xa = x2
                xb = x1
            self.fill_rect(xa, y1, xb - xa + 1, 1, color)
            return
        if adx == zero:
            ya: i32 = y1
            yb: i32 = y2
            if ya > yb:
                ya = y2
                yb = y1
            self.fill_rect(x1, ya, 1, yb - ya + 1, color)
            return

        # Pick the major axis (the one we step 1 pixel at a time).
        # adx >= ady  → step in x; adx < ady → step in y.
        if adx >= ady:
            # X-major
            xa: i32 = x1
            ya: i32 = y1
            xb: i32 = x2
            yb: i32 = y2
            if xa > xb:
                xa = x2
                ya = y2
                xb = x1
                yb = y1
            # gradient in Q8 — how much y advances per one x step
            grad: i32 = ((yb - ya) * 256) / (xb - xa)
            yq: i32 = ya * 256             # current y in Q8
            xi: i32 = xa
            yi: i32 = zero
            frac: i32 = zero
            while xi <= xb:
                yi = yq / 256
                frac = yq - yi * 256
                if frac < zero:
                    frac = frac + 256
                    yi = yi - 1
                self.blend_pixel(xi, yi,     color, 255 - frac)
                self.blend_pixel(xi, yi + 1, color, frac)
                yq = yq + grad
                xi = xi + 1
        else:
            # Y-major
            xa: i32 = x1
            ya: i32 = y1
            xb: i32 = x2
            yb: i32 = y2
            if ya > yb:
                xa = x2
                ya = y2
                xb = x1
                yb = y1
            grad: i32 = ((xb - xa) * 256) / (yb - ya)
            xq: i32 = xa * 256
            yi: i32 = ya
            xi: i32 = zero
            frac: i32 = zero
            while yi <= yb:
                xi = xq / 256
                frac = xq - xi * 256
                if frac < zero:
                    frac = frac + 256
                    xi = xi - 1
                self.blend_pixel(xi,     yi, color, 255 - frac)
                self.blend_pixel(xi + 1, yi, color, frac)
                xq = xq + grad
                yi = yi + 1

    # Internal: thick Bresenham line (block at each step). Called by
    # line() when thickness > 1.
    fun _line_thick(self, x1: i32, y1: i32, x2: i32, y2: i32, color: DrawColor, t: i32):
        radius_pixels: i32 = (t + 1) / 2 + 1
        min_x: i32 = x1
        max_x: i32 = x2
        min_y: i32 = y1
        max_y: i32 = y2
        if min_x > max_x:
            min_x = x2
            max_x = x1
        if min_y > max_y:
            min_y = y2
            max_y = y1
        min_x = min_x - radius_pixels
        min_y = min_y - radius_pixels
        max_x = max_x + radius_pixels
        max_y = max_y + radius_pixels
        if min_x < 0:
            min_x = 0
        if min_y < 0:
            min_y = 0
        if max_x >= self.width:
            max_x = self.width - 1
        if max_y >= self.height:
            max_y = self.height - 1
        if self.clip_active == 1:
            if min_x < self.clip_x:
                min_x = self.clip_x
            if min_y < self.clip_y:
                min_y = self.clip_y
            if max_x >= self.clip_x + self.clip_w:
                max_x = self.clip_x + self.clip_w - 1
            if max_y >= self.clip_y + self.clip_h:
                max_y = self.clip_y + self.clip_h - 1

        radius_q8: i32 = t * 128
        py: i32 = min_y
        px: i32 = min_x
        coverage: i32 = 0
        while py <= max_y:
            px = min_x
            while px <= max_x:
                coverage = draw_line_coverage_q8(px, py, x1, y1, x2, y2, radius_q8)
                if coverage > 0:
                    self.blend_pixel(px, py, color, coverage)
                px = px + 1
            py = py + 1

    fun text(self, x: i32, y: i32, value: str, color: DrawColor):
        if self.fb_valid == 0:
            return
        if self.font == 0:
            return
        zero: i32 = self.fb_valid - self.fb_valid
        shown: str = self.prepare_text(value)
        text_ptr: i64 = shown as i64
        length: i32 = Memory.strlen(shown) as i32
        i: i32 = zero
        ch: i32 = zero
        glyph_index: i32 = zero
        base: i64 = zero as i64
        row_byte: i32 = zero
        rx: i32 = zero
        ry: i32 = zero
        px: i32 = zero
        py: i32 = zero
        cursor_x: i32 = x
        alpha: i32 = (color >> 24) & 255
        decoded: Utf8Char = Utf8Char()
        # How far back a mark is drawn: over the letter just placed, since
        # the pen has already moved past it.
        mark_back: i32 = 0
        previous_advance: i32 = 0
        step_width: i32 = 0
        while i < length:
            decoded = utf8_decode(text_ptr, i as i64, length as i64)
            if decoded.size <= zero:
                return
            ch = decoded.codepoint
            glyph_index = self.font_glyph_index(ch)
            if glyph_index >= zero:
                base = self.font + (glyph_index as i64) * (self.font_stride as i64)
                ry = zero
                while ry < self.font_height:
                    if self.font_format == 0:
                        row_byte = Memory.read_i8(base + (ry as i64)) & 255
                    rx = zero
                    while rx < self.font_width:
                        coverage: i32 = 0
                        if self.font_format == FONT_FORMAT_A8:
                            coverage = Memory.read_i8(base + (ry as i64) * (self.font_width as i64) + (rx as i64)) & 255
                        elif (row_byte & (128 >> rx)) != 0:
                            coverage = 255
                        if coverage > 0:
                            px = cursor_x - mark_back + rx
                            py = y + ry
                            if px >= zero and py >= zero and px < self.width and py < self.height:
                                if self.clip_active == 0 or (px >= self.clip_x and py >= self.clip_y and px < self.clip_x + self.clip_w and py < self.clip_y + self.clip_h):
                                    if alpha >= 255 and coverage >= 255:
                                        Memory.write_i32(self.fb_data + (py as i64) * (self.fb_pitch as i64) + (px as i64) * 4, color)
                                    else:
                                        self.blend_pixel(px, py, color, coverage)
                        rx = rx + 1
                    ry = ry + 1
            step_width = self.advance_for(ch, glyph_index)
            if step_width > 0:
                previous_advance = step_width
                mark_back = 0
            else:
                mark_back = previous_advance
            cursor_x = cursor_x + step_width
            i = i + decoded.size

    fun text_bg(self, x: i32, y: i32, value: str, color: DrawColor, background: DrawColor):
        if self.fb_valid == 0:
            return
        self.fill_rect(x, y, self.measure_text(value), self.font_line_height, background)
        self.text(x, y, value, color)

    # Render text with an integer scale factor (1 = 8x8, 2 = 16x16, 3 = 24x24, ...).
    # Each glyph bit is drawn as a scale×scale block of pixels via fill_rect,
    # so clip handling is inherited for free.
    fun text_scaled(self, x: i32, y: i32, value: str, color: DrawColor, scale: i32):
        if self.fb_valid == 0:
            return
        if self.font == 0:
            return
        s: i32 = scale
        if s <= 0:
            s = self.fb_valid - self.fb_valid + 1
        if s == 1:
            self.text(x, y, value, color)
            return
        zero: i32 = self.fb_valid - self.fb_valid
        shown: str = self.prepare_text(value)
        text_ptr: i64 = shown as i64
        length: i32 = Memory.strlen(shown) as i32
        i: i32 = zero
        ch: i32 = zero
        glyph_index: i32 = zero
        base: i64 = zero as i64
        row_byte: i32 = zero
        rx: i32 = zero
        ry: i32 = zero
        px: i32 = zero
        py: i32 = zero
        cursor_x: i32 = x
        decoded: Utf8Char = Utf8Char()
        # How far back a mark is drawn: over the letter just placed, since
        # the pen has already moved past it.
        mark_back: i32 = 0
        previous_advance: i32 = 0
        step_width: i32 = 0
        while i < length:
            decoded = utf8_decode(text_ptr, i as i64, length as i64)
            if decoded.size <= zero:
                return
            ch = decoded.codepoint
            glyph_index = self.font_glyph_index(ch)
            if glyph_index >= zero:
                base = self.font + (glyph_index as i64) * (self.font_stride as i64)
                ry = zero
                while ry < self.font_height:
                    if self.font_format == 0:
                        row_byte = Memory.read_i8(base + (ry as i64)) & 255
                    rx = zero
                    while rx < self.font_width:
                        coverage: i32 = 0
                        if self.font_format == FONT_FORMAT_A8:
                            coverage = Memory.read_i8(base + (ry as i64) * (self.font_width as i64) + (rx as i64)) & 255
                        elif (row_byte & (128 >> rx)) != 0:
                            coverage = 255
                        if coverage > 0:
                            px = cursor_x - mark_back * s + rx * s
                            py = y + ry * s
                            if coverage >= 255:
                                self.fill_rect(px, py, s, s, color)
                            else:
                                sy: i32 = 0
                                sx: i32 = 0
                                while sy < s:
                                    sx = 0
                                    while sx < s:
                                        self.blend_pixel(px + sx, py + sy, color, coverage)
                                        sx = sx + 1
                                    sy = sy + 1
                        rx = rx + 1
                    ry = ry + 1
            step_width = self.advance_for(ch, glyph_index)
            if step_width > 0:
                previous_advance = step_width
                mark_back = 0
            else:
                mark_back = previous_advance
            cursor_x = cursor_x + step_width * s
            i = i + decoded.size

    fun text_scaled_bg(self, x: i32, y: i32, value: str, color: DrawColor, background: DrawColor, scale: i32):
        if self.fb_valid == 0:
            return
        s: i32 = scale
        if s <= 0:
            s = self.fb_valid - self.fb_valid + 1
        self.fill_rect(x, y, self.measure_text(value) * s, self.font_line_height * s, background)
        self.text_scaled(x, y, value, color, s)

    # ----- Clip region -----

    fun set_clip(self, x: i32, y: i32, width: i32, height: i32):
        if self.fb_valid == 0:
            return
        self.clip_x = x
        self.clip_y = y
        self.clip_w = width
        self.clip_h = height
        self.clip_active = self.fb_valid - self.fb_valid + 1

    fun intersect_clip(self, x: i32, y: i32, width: i32, height: i32):
        nx: i32 = x
        ny: i32 = y
        right: i32 = x + width
        bottom: i32 = y + height
        if self.clip_active == 1:
            if nx < self.clip_x:
                nx = self.clip_x
            if ny < self.clip_y:
                ny = self.clip_y
            if right > self.clip_x + self.clip_w:
                right = self.clip_x + self.clip_w
            if bottom > self.clip_y + self.clip_h:
                bottom = self.clip_y + self.clip_h
        width = right - nx
        height = bottom - ny
        if width < 0:
            width = 0
        if height < 0:
            height = 0
        self.set_clip(nx, ny, width, height)

    fun clear_clip(self):
        self.clip_active = self.fb_valid - self.fb_valid

    # ----- Circle (filled) — scanline using isqrt -----

    # Fast solid spans plus 4x4 coverage on the narrow boundary ring.
    fun fill_circle(self, cx: i32, cy: i32, radius: i32, color: DrawColor):
        if self.fb_valid == 0:
            return
        if radius <= 0:
            return
        inner_radius: i32 = radius - 1
        if inner_radius < 0:
            inner_radius = 0
        outer_limit: i32 = radius + 1
        outer2: i32 = outer_limit * outer_limit
        inner2: i32 = inner_radius * inner_radius
        yy: i32 = 0 - outer_limit
        outer_span: i32 = 0
        inner_span: i32 = -1
        xx: i32 = 0
        coverage: i32 = 0
        while yy <= outer_limit:
            if yy * yy <= outer2:
                outer_span = draw_isqrt(outer2 - yy * yy)
                inner_span = -1
                if inner_radius > 0 and yy * yy <= inner2:
                    inner_span = draw_isqrt(inner2 - yy * yy)
                    self.fill_rect(cx - inner_span, cy + yy, inner_span * 2 + 1, 1, color)
                xx = 0 - outer_span
                while xx <= outer_span:
                    if inner_span < 0 or xx < (0 - inner_span) or xx > inner_span:
                        coverage = draw_circle_coverage_q8(xx * 256, yy * 256, radius * 256, 0)
                        if coverage > 0:
                            self.blend_pixel(cx + xx, cy + yy, color, coverage)
                    xx = xx + 1
            yy = yy + 1

    # ----- Circle (outline) — AA annulus between outer and inner radii -----

    fun outline_circle(self, cx: i32, cy: i32, radius: i32, color: DrawColor, thickness: i32):
        if self.fb_valid == 0:
            return
        if radius <= 0:
            return
        t: i32 = thickness
        if t <= 0:
            t = self.fb_valid - self.fb_valid + 1
        if t >= radius:
            self.fill_circle(cx, cy, radius, color)
            return
        inner: i32 = radius - t
        outer_limit: i32 = radius + 1
        limit2: i32 = outer_limit * outer_limit
        yy: i32 = 0 - outer_limit
        xx: i32 = 0
        span: i32 = 0
        coverage: i32 = 0
        while yy <= outer_limit:
            if yy * yy <= limit2:
                span = draw_isqrt(limit2 - yy * yy)
                xx = 0 - span
                while xx <= span:
                    coverage = draw_circle_coverage_q8(xx * 256, yy * 256, radius * 256, inner * 256)
                    if coverage > 0:
                        self.blend_pixel(cx + xx, cy + yy, color, coverage)
                    xx = xx + 1
            yy = yy + 1

    # ----- Rounded rect (filled) -----

    # ----- Triangle (filled) -----
    #
    # Sampled sixteen times per pixel rather than scanned with an analytic
    # edge, because an icon's arrowhead is a dozen pixels across and its
    # diagonal is the whole of what the eye sees. Sixteen samples cost nothing
    # at that size and give an edge indistinguishable from an exact one.
    fun fill_triangle(self, x1: i32, y1: i32, x2: i32, y2: i32, x3: i32, y3: i32, color: DrawColor):
        if self.fb_valid == 0:
            return
        min_x: i32 = x1
        if x2 < min_x:
            min_x = x2
        if x3 < min_x:
            min_x = x3
        max_x: i32 = x1
        if x2 > max_x:
            max_x = x2
        if x3 > max_x:
            max_x = x3
        min_y: i32 = y1
        if y2 < min_y:
            min_y = y2
        if y3 < min_y:
            min_y = y3
        max_y: i32 = y1
        if y2 > max_y:
            max_y = y2
        if y3 > max_y:
            max_y = y3
        if max_x < min_x or max_y < min_y:
            return

        # Eighths of a pixel, so the four sub-samples across sit at 1, 3, 5
        # and 7 — the centres of the quarters, none of them on an edge.
        ax: i64 = (x1 as i64) * 8
        ay: i64 = (y1 as i64) * 8
        bx: i64 = (x2 as i64) * 8
        by: i64 = (y2 as i64) * 8
        cx: i64 = (x3 as i64) * 8
        cy: i64 = (y3 as i64) * 8

        py: i32 = min_y
        px: i32 = 0
        sx: i32 = 0
        sy: i32 = 0
        hits: i32 = 0
        sample_x: i64 = 0
        sample_y: i64 = 0
        e1: i64 = 0
        e2: i64 = 0
        e3: i64 = 0
        coverage: i32 = 0
        while py <= max_y:
            px = min_x
            while px <= max_x:
                hits = 0
                sy = 0
                while sy < 4:
                    sx = 0
                    while sx < 4:
                        sample_x = (px as i64) * 8 + (sx as i64) * 2 + 1
                        sample_y = (py as i64) * 8 + (sy as i64) * 2 + 1
                        e1 = (bx - ax) * (sample_y - ay) - (by - ay) * (sample_x - ax)
                        e2 = (cx - bx) * (sample_y - by) - (cy - by) * (sample_x - bx)
                        e3 = (ax - cx) * (sample_y - cy) - (ay - cy) * (sample_x - cx)
                        # Same sign on all three edges, either winding, so the
                        # caller never has to know which way round it wound.
                        if e1 >= 0 and e2 >= 0 and e3 >= 0:
                            hits = hits + 1
                        elif e1 <= 0 and e2 <= 0 and e3 <= 0:
                            hits = hits + 1
                        sx = sx + 1
                    sy = sy + 1
                if hits > 0:
                    coverage = hits * 16
                    if coverage > 255:
                        coverage = 255
                    self.blend_pixel(px, py, color, coverage)
                px = px + 1
            py = py + 1

    # ----- Arc (stroked) -----
    #
    # Degrees, with y running down the screen: 0 points right, 90 points down,
    # and the sweep runs from start to end that way round. The band comes from
    # the same annulus coverage an outlined circle uses, so an arc and a circle
    # drawn at one radius meet without a seam; the ends are cut by asking which
    # side of the two bounding directions a pixel falls on, which needs no
    # inverse trigonometry and no floating point.
    fun arc(self, cx: i32, cy: i32, radius: i32, start_deg: i32, end_deg: i32, color: DrawColor, thickness: i32):
        if self.fb_valid == 0:
            return
        if radius <= 0 or thickness <= 0:
            return
        sweep: i32 = end_deg - start_deg
        while sweep < 0:
            sweep = sweep + 360
        if sweep == 0:
            return

        outer_q8: i32 = (radius * 2 + thickness) * 128
        inner_q8: i32 = (radius * 2 - thickness) * 128
        if inner_q8 < 0:
            inner_q8 = 0
        limit: i32 = (outer_q8 / 256) + 2

        start_x: i64 = draw_cos_q10(start_deg) as i64
        start_y: i64 = draw_sin_q10(start_deg) as i64
        end_x: i64 = draw_cos_q10(end_deg) as i64
        end_y: i64 = draw_sin_q10(end_deg) as i64

        yy: i32 = 0 - limit
        xx: i32 = 0
        coverage: i32 = 0
        inside: i32 = 0
        from_start: i64 = 0
        to_end: i64 = 0
        while yy <= limit:
            xx = 0 - limit
            while xx <= limit:
                coverage = draw_circle_coverage_q8(xx * 256, yy * 256, outer_q8, inner_q8)
                if coverage > 0:
                    inside = 0
                    if sweep >= 360:
                        inside = 1
                    else:
                        from_start = start_x * (yy as i64) - start_y * (xx as i64)
                        to_end = (xx as i64) * end_y - (yy as i64) * end_x
                        if sweep <= 180:
                            # A wedge of half a turn or less is the overlap of
                            # the two half-planes.
                            if from_start >= 0 and to_end >= 0:
                                inside = 1
                        else:
                            # A wider one is everything except the wedge left
                            # over, which is itself half a turn or less.
                            if from_start >= 0 or to_end >= 0:
                                inside = 1
                    if inside == 1:
                        self.blend_pixel(cx + xx, cy + yy, color, coverage)
                xx = xx + 1
            yy = yy + 1

    fun fill_rounded_rect(self, x: i32, y: i32, width: i32, height: i32, radius: i32, color: DrawColor):
        if self.fb_valid == 0:
            return
        if width <= 0 or height <= 0:
            return
        r: i32 = radius
        if r <= 0:
            self.fill_rect(x, y, width, height, color)
            return
        if r > width / 2:
            r = width / 2
        if r > height / 2:
            r = height / 2
        # Three non-overlapping fast rectangular regions.
        self.fill_rect(x + r, y, width - 2 * r, height, color)
        self.fill_rect(x, y + r, r, height - 2 * r, color)
        self.fill_rect(x + width - r, y + r, r, height - 2 * r, color)

        # One coverage calculation is mirrored to all four corners.
        yy: i32 = 0
        xx: i32 = 0
        dx_q8: i32 = 0
        dy_q8: i32 = 0
        coverage: i32 = 0
        while yy < r:
            xx = 0
            while xx < r:
                dx_q8 = (xx - r) * 256 + 128
                dy_q8 = (yy - r) * 256 + 128
                coverage = draw_circle_coverage_q8(dx_q8, dy_q8, r * 256, 0)
                if coverage > 0:
                    self.blend_pixel(x + xx, y + yy, color, coverage)
                    self.blend_pixel(x + width - 1 - xx, y + yy, color, coverage)
                    self.blend_pixel(x + xx, y + height - 1 - yy, color, coverage)
                    self.blend_pixel(x + width - 1 - xx, y + height - 1 - yy, color, coverage)
                xx = xx + 1
            yy = yy + 1

    # ----- Rounded rect (outline) -----
    #
    # Draws 4 straight edges plus 4 quarter-arcs at the corners.
    # To get clean quarter-arcs we temporarily clip to each corner quadrant
    # and draw a full outline_circle — only the corner slice survives the clip.

    fun outline_rounded_rect(self, x: i32, y: i32, width: i32, height: i32, radius: i32, color: DrawColor, thickness: i32):
        if self.fb_valid == 0:
            return
        if width <= 0 or height <= 0:
            return
        t: i32 = thickness
        if t <= 0:
            t = self.fb_valid - self.fb_valid + 1
        r: i32 = radius
        if r <= 0:
            self.outline_rect(x, y, width, height, color, t)
            return
        if r > width / 2:
            r = width / 2
        if r > height / 2:
            r = height / 2

        # Save outer clip so we can layer ours on top and restore after.
        saved_x: i32 = self.clip_x
        saved_y: i32 = self.clip_y
        saved_w: i32 = self.clip_w
        saved_h: i32 = self.clip_h
        saved_a: i32 = self.clip_active

        # Straight edges (inset by radius so they don't overlap corner arcs)
        self.fill_rect(x + r, y, width - 2 * r, t, color)                # top
        self.fill_rect(x + r, y + height - t, width - 2 * r, t, color)   # bottom
        self.fill_rect(x, y + r, t, height - 2 * r, color)               # left
        self.fill_rect(x + width - t, y + r, t, height - 2 * r, color)   # right

        # Corner quadrants. Each clip is the radius-sized box containing
        # one corner (extended by 1px inward on the sides that meet the
        # straight edges, so the arc and edge pixels touch cleanly with
        # no 1px notch). A full outline_circle is drawn; only the corner
        # quadrant plus the 1px seam survives the clip.
        if saved_a == 1:
            self.set_clip(saved_x, saved_y, saved_w, saved_h)
        else:
            self.clear_clip()
        self.intersect_clip(x, y, r + 1, r + 1)
        self.outline_circle(x + r, y + r, r, color, t)

        if saved_a == 1:
            self.set_clip(saved_x, saved_y, saved_w, saved_h)
        else:
            self.clear_clip()
        self.intersect_clip(x + width - r - 1, y, r + 1, r + 1)
        self.outline_circle(x + width - r - 1, y + r, r, color, t)

        if saved_a == 1:
            self.set_clip(saved_x, saved_y, saved_w, saved_h)
        else:
            self.clear_clip()
        self.intersect_clip(x, y + height - r - 1, r + 1, r + 1)
        self.outline_circle(x + r, y + height - r - 1, r, color, t)

        if saved_a == 1:
            self.set_clip(saved_x, saved_y, saved_w, saved_h)
        else:
            self.clear_clip()
        self.intersect_clip(x + width - r - 1, y + height - r - 1, r + 1, r + 1)
        self.outline_circle(x + width - r - 1, y + height - r - 1, r, color, t)

        # Restore previous clip state
        if saved_a == 1:
            self.set_clip(saved_x, saved_y, saved_w, saved_h)
        else:
            self.clear_clip()

fun draw_canvas_from_buffer(pixels: i64, width: i32, height: i32, pitch: i32, font: i64) -> DrawCanvas:
    canvas: DrawCanvas = draw_canvas_empty()
    canvas.width = width
    canvas.height = height
    if pixels == 0 or width <= 0 or height <= 0:
        return canvas
    if pitch < width * 4:
        return canvas
    canvas.fb_data = pixels
    canvas.fb_pitch = pitch
    canvas.font = font
    canvas.fb_valid = 1
    return canvas

fun draw_canvas_from_font_face(pixels: i64, width: i32, height: i32, pitch: i32, font: i64, font_width: i32, font_height: i32, font_advance: i32, font_line_height: i32, font_first: i32, font_count: i32, font_stride: i32, font_format: i32) -> DrawCanvas:
    canvas: DrawCanvas = draw_canvas_empty()
    canvas.width = width
    canvas.height = height
    if pixels == 0 or width <= 0 or height <= 0:
        return canvas
    if pitch < width * 4:
        return canvas
    canvas.fb_data = pixels
    canvas.fb_pitch = pitch
    canvas.font = font
    canvas.font_width = font_width
    canvas.font_height = font_height
    canvas.font_advance = font_advance
    canvas.font_line_height = font_line_height
    canvas.font_first = font_first
    canvas.font_count = font_count
    canvas.font_stride = font_stride
    canvas.font_format = font_format
    canvas.fb_valid = 1
    return canvas

# Same, plus the second glyph block. Kept separate so the existing entry
# points keep compiling for callers with a single-range face.
fun draw_canvas_from_font_face_ranges(pixels: i64, width: i32, height: i32, pitch: i32, font: i64, font_width: i32, font_height: i32, font_advance: i32, font_line_height: i32, font_first: i32, font_count: i32, font_stride: i32, font_format: i32, font_advances: i64, font_first2: i32, font_count2: i32) -> DrawCanvas:
    canvas: DrawCanvas = draw_canvas_from_font_face_metrics(pixels, width, height, pitch, font, font_width, font_height, font_advance, font_line_height, font_first, font_count, font_stride, font_format, font_advances)
    canvas.font_first2 = font_first2
    canvas.font_count2 = font_count2
    return canvas

fun draw_canvas_from_font_face_metrics(pixels: i64, width: i32, height: i32, pitch: i32, font: i64, font_width: i32, font_height: i32, font_advance: i32, font_line_height: i32, font_first: i32, font_count: i32, font_stride: i32, font_format: i32, font_advances: i64) -> DrawCanvas:
    canvas: DrawCanvas = draw_canvas_from_font_face(pixels, width, height, pitch, font, font_width, font_height, font_advance, font_line_height, font_first, font_count, font_stride, font_format)
    canvas.font_advances = font_advances
    return canvas
